<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative Vault | NeuroMagic</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/jameel-noori@1.1.2/jameel-noori.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','sans-serif'],display:['Outfit','sans-serif'],urdu:['Jameel Noori Nastaleeq','sans-serif']}}}}</script>
    <style>
        body { background: #f8fafc; font-family: 'Inter', sans-serif; transition: all 0.3s ease; }
        .display-font { font-family: 'Outfit', sans-serif; }
        .creation-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 20px; padding: 24px; transition: all .2s; cursor: pointer; }
        .creation-card:hover { border-color: #3b82f6; box-shadow: 0 8px 24px rgba(59,130,246,.08); transform: translateY(-2px); }
        [dir="rtl"] { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; }
    </style>
</head>
<body class="antialiased text-slate-900">

<%- include('../partials/sidebar') %>

<main class="lg:ml-64 min-h-screen transition-all duration-300 rtl:ml-0 rtl:lg:mr-64">
    <div class="p-6 flex justify-end">
        <button onclick="toggleLang()" class="text-xs font-bold text-slate-500 bg-white border border-slate-100 px-4 py-2 rounded-xl hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm">
            <i class="fa-solid fa-earth-asia"></i> <span id="lang-label">EN / اردو</span>
        </button>
    </div>
    <div class="max-w-5xl mx-auto px-6 py-6 lg:py-12">
        
        <div class="mb-12 text-center lg:text-left rtl:lg:text-right">
            <h1 class="text-4xl font-extrabold display-font tracking-tight mb-2" data-en="Creative Vault" data-ur="تخلیقی خزانہ">Creative Vault</h1>
            <p class="text-slate-500 font-medium" data-en="Your curated collection of masterpieces." data-ur="آپ کے منتخب کردہ شاہکاروں کا مجموعہ۔">Your curated collection of masterpieces.</p>
        </div>

        <div id="favorites-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="col-span-full flex flex-col items-center py-20 text-slate-300">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mb-4">
                    <i class="fa-solid fa-bookmark text-2xl"></i>
                </div>
                <p class="font-bold" data-en="Vault is empty." data-ur="خزانہ خالی ہے۔">Vault is empty.</p>
                <a href="/user/enhance-creation" class="text-blue-600 font-bold mt-2 hover:underline" data-en="Start creating now" data-ur="ابھی تخلیق شروع کریں">Start creating now</a>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/bottom_nav') %>

<div id="modal-overlay" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] hidden items-center justify-center p-4" onclick="if(event.target===this)closeModal()">
    <div class="bg-white rounded-3xl p-8 w-full max-w-xl shadow-2xl relative">
        <button onclick="closeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600">
            <i class="fa-solid fa-xmark text-xl"></i>
        </button>
        <h3 id="modal-title" class="text-2xl font-bold display-font mb-4" data-en="Creation Details" data-ur="تخلیق کی تفصیلات">Creation Details</h3>
        <div class="bg-slate-50 border border-slate-100 rounded-2xl p-5 mb-6 max-h-96 overflow-y-auto">
            <p id="modal-text" class="text-slate-700 leading-relaxed whitespace-pre-wrap font-medium"></p>
        </div>
        <button onclick="copyResult()" id="copy-btn" class="w-full py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-black transition-all flex items-center justify-center gap-2">
            <i class="fa-regular fa-copy"></i> <span data-en="Copy Creation" data-ur="تخلیق کاپی کریں">Copy Creation</span>
        </button>
    </div>
</div>

<script>
let currentResult = '';

function applyLang() {
    if (typeof globalApplyLang === 'function') {
        globalApplyLang();
    }
}

async function loadFavorites() {
    try {
        const res = await fetch('/user/favorites');
        const data = await res.json();
        const grid = document.getElementById('favorites-grid');
        const isUrdu = (localStorage.getItem('preferred_lang') || 'en') === 'ur';
        
        if (data && data.length > 0) {
            grid.innerHTML = data.map(f => {
                const content = (f.content || '').replace(/`/g,'\\`').replace(/\n/g,'\\n');
                return `
                <div class="creation-card" onclick="viewResult(\`${content}\`, '${f.title || 'Untitled'}')">
                    <div class="flex items-center gap-3 mb-4">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
                            <i class="fa-solid fa-heart"></i>
                        </div>
                        <div class="text-left rtl:text-right">
                            <h4 class="font-bold text-slate-900 line-clamp-1">${f.title || 'Untitled'}</h4>
                            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">${new Date(f.created_at).toLocaleDateString()}</span>
                        </div>
                    </div>
                    <p class="text-slate-500 text-sm line-clamp-3 mb-4 leading-relaxed text-left rtl:text-right">${f.content || ''}</p>
                    <div class="flex items-center justify-end text-blue-600 font-bold text-xs uppercase tracking-widest group">
                        <span data-en="View Details" data-ur="تفصیلات دیکھیں">${isUrdu ? 'تفصیلات دیکھیں' : 'View Details'}</span> <i class="fa-solid fa-arrow-right ml-2 rtl:mr-2 rtl:ml-0 rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform"></i>
                    </div>
                </div>`;
            }).join('');
            applyLang(); 
        }
    } catch(e) {
        console.error("Load Favorites Error:", e);
    }
}

function viewResult(p, t) {
    currentResult = p;
    document.getElementById('modal-text').innerText = p;
    document.getElementById('modal-title').innerText = t;
    document.getElementById('modal-overlay').classList.remove('hidden');
    document.getElementById('modal-overlay').classList.add('flex');
}

function closeModal() {
    document.getElementById('modal-overlay').classList.add('hidden');
    document.getElementById('modal-overlay').classList.remove('flex');
}

function copyResult() {
    navigator.clipboard.writeText(currentResult).then(() => {
        const btn = document.getElementById('copy-btn');
        const originalHtml = btn.innerHTML;
        const isUrdu = localStorage.getItem('preferred_lang') === 'ur';
        btn.innerHTML = '<i class="fa-solid fa-check"></i> ' + (isUrdu ? 'کاپی ہو گیا!' : 'Copied!');
        btn.style.background = '#16a34a';
        setTimeout(() => {
            btn.innerHTML = originalHtml;
            btn.style.background = '#0f172a';
        }, 2000);
    });
}

function toggleLang() {
    const currentLang = localStorage.getItem('preferred_lang') === 'en' ? 'ur' : 'en';
    localStorage.setItem('preferred_lang', currentLang);
    window.dispatchEvent(new Event('languageChanged'));
    applyLang();
}

window.onload = () => {
    applyLang();
    loadFavorites();
};
window.addEventListener('languageChanged', () => {
    applyLang();
    loadFavorites();
});
</script>
</body>
</html>
