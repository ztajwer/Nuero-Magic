        async function loadProjectFolders() {
            if (!canUseProjectMemory) return;
            const select = document.getElementById('project-select');
            if (!select) return;
            try {
                const res = await fetch('/user/projects');
                if (!res.ok) return;
                const rows = await res.json();
                select.innerHTML = '<option value="">No folder selected</option>';
                (rows || []).forEach((row) => {
                    const opt = document.createElement('option');
                    opt.value = row.id;
                    opt.innerText = row.name;
                    select.appendChild(opt);
                });
            } catch (_) {}
        }

        async function createProjectFolder() {
            if (!canUseProjectMemory) {
                showToast('🔒', currentLang === 'ur' ? 'یہ فیچر صرف Plus پلان کے لیے ہے۔' : 'This feature is for Plus users only.', true);
                return;
            }
            const nameInput = document.getElementById('project-name-input');
            const name = nameInput?.value.trim();
            if (!name) {
                showToast('⚠️', currentLang === 'ur' ? 'پہلے فولڈر کا نام لکھیں۔' : 'Enter a folder name first.', true);
                return;
            }
            setBtnLoading('project-create-btn', true, currentLang === 'ur' ? 'بن رہا ہے...' : 'Creating...');
            try {
                const res = await fetch('/user/projects', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.error || 'Could not create folder.');
                if (nameInput) nameInput.value = '';
                await loadProjectFolders();
                const select = document.getElementById('project-select');
                if (select) select.value = String(data.id);
                showToast('📁', currentLang === 'ur' ? 'فولڈر بن گیا!' : 'Project folder created.');
            } catch (e) {
                showToast('❌', e.message || 'Failed', true);
            } finally {
                setBtnLoading('project-create-btn', false);
            }
        }

        async function translateResult() {
            if (!currentResult) return;
            const target = currentLang === 'en' ? 'ur' : 'en';
            setBtnLoading('translate-btn', true, currentLang === 'ur' ? 'ترجمہ ہو رہا ہے...' : 'Translating...');
            showToast('🌐', target === 'ur' ? 'ترجمہ ہو رہا ہے...' : 'Translating...');
            try {
                const res = await fetch('/api', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ 
                        input: `Translate the following text into ${target === 'ur' ? 'Urdu' : 'English'}: \n\n${currentResult}`,
                        type: 'standard',
                        lang: target,
                        tone: 'professional',
                        level: 'standard'
                    })
                });
                const data = await res.json();
                if (data.text) {
                    showResult(data.text, `Translation (${target.toUpperCase()})`);
                }
            } catch (e) { showToast('❌', 'Translation failed', true); }
            finally { setBtnLoading('translate-btn', false); }
        }

        function regenerate() {
            setBtnLoading('regen-btn', true, currentLang === 'ur' ? 'دوبارہ بنایا جا رہا ہے...' : 'Regenerating...');
            closeModal();
            Promise.resolve(enhanceCreation()).finally(() => setBtnLoading('regen-btn', false));
        }

        function showToast(icon, msg, isError = false) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-icon').className = isError ? 'fa-solid fa-triangle-exclamation text-red-400' : 'fa-solid fa-check text-green-400';
            document.getElementById('toast-msg').innerText = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        function handleOtherOption(fieldId, value) {
            const otherInputDiv = document.getElementById(fieldId + '-other');
            const selectElement = document.getElementById(fieldId);
            
            if (value === 'Other') {
                otherInputDiv.classList.remove('hidden');
                document.getElementById(fieldId + '-text').focus();
            } else {
                otherInputDiv.classList.add('hidden');
                document.getElementById(fieldId + '-text').value = '';
            }
        }

        function updateOtherValue(fieldId) {
            const otherText = document.getElementById(fieldId + '-text').value.trim();
            const selectElement = document.getElementById(fieldId);
            
            if (otherText) {
                selectElement.value = otherText;
            }
        }

        function toggleLang() {
            currentLang = currentLang === 'en' ? 'ur' : 'en';
            localStorage.setItem('preferred_lang', currentLang);
            applyLang();
        }
        function applyLang() {
            if (typeof globalApplyLang === 'function') globalApplyLang();
            renderCards(); renderTemplates(); renderHistory();
        }
        function escH(str) { return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

        window.onload = () => {
            applyLang();
            applyFeatureAccess();
            loadProjectFolders();
            
            // Auto-save logic
            const mainInput = document.getElementById('ai-input');
            mainInput.addEventListener('input', () => {
                sessionStorage.setItem('ai_input_saved', mainInput.value);
            });
            
            // Handle restore of ai-input
            const savedInput = sessionStorage.getItem('ai_input_saved');
            if (savedInput) {
                mainInput.value = savedInput;
            }
            
            // Handle restore of modal state
            const savedModalState = sessionStorage.getItem('modal_state');
            if (savedModalState) {
                try {
                    const state = JSON.parse(savedModalState);
                    currentOriginalInput = state.originalInput;
                    
                    // Reopen the modal logic
                    openModal();
                    showResult(state.text, state.label);
                    
                    // Restore answers if clarification
                    if (state.type === 'clarification' && state.answers && state.answers.length > 0) {
                        const inputs = document.querySelectorAll('.clarification-input');
                        inputs.forEach((input, idx) => {
                            if (state.answers[idx]) {
                                input.value = state.answers[idx];
                            }
                        });
                    }
                } catch(e) {}
            }

            // Handle remix from history page
            const remixInput = sessionStorage.getItem('remix_input');
            const remixType = sessionStorage.getItem('remix_type');
            if (remixInput) {
                document.getElementById('ai-input').value = remixInput;
                if (remixType) document.getElementById('creation-type').value = remixType;
                sessionStorage.removeItem('remix_input');
                sessionStorage.removeItem('remix_type');
                showToast('✨', currentLang === 'ur' ? 'ڈیٹا لوڈ ہو گیا!' : 'Magic loaded! Ready to remix.');
            }

            // Handle prefilled prompt from Generate Prompt wizard
            const prefilled = sessionStorage.getItem('prefilled_prompt');
            const prefilledType = sessionStorage.getItem('prefilled_type');
            const prefilledTone = sessionStorage.getItem('prefilled_tone');
            if (prefilled) {
                document.getElementById('ai-input').value = prefilled;
                if (prefilledType) document.getElementById('creation-type').value = prefilledType;
                if (prefilledTone) document.getElementById('creation-tone').value = prefilledTone;
                sessionStorage.removeItem('prefilled_prompt');
                sessionStorage.removeItem('prefilled_type');
                sessionStorage.removeItem('prefilled_tone');
                // Focus the textarea and set cursor at end
                const el = document.getElementById('ai-input');
                el.focus();
                el.setSelectionRange(el.value.length, el.value.length);
                showToast('🪄', currentLang === 'ur' ? 'پرامپٹ تیار ہے!' : 'Prompt generated! Just add your details.');
            }
        };
    </script>

</body>
</html>