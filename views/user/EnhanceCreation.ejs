        // ═══ MODAL ═══
        function openModal() {
            document.getElementById('modal-overlay').classList.add('show');
            document.body.style.overflow = 'hidden';
        }
        function closeModal() {
            document.getElementById('modal-overlay').classList.remove('show');
            document.body.style.overflow = '';
            // Clear modal state
            sessionStorage.removeItem('modal_state');
        }
        function handleOverlayClick(e) { if (e.target.id === 'modal-overlay') closeModal(); }

        function showLoading() {
            document.getElementById('modal-label').innerText = '';
            document.getElementById('modal-loading').classList.remove('hidden');
            document.getElementById('modal-content').classList.add('hidden');
            openModal();
        }
        function showResult(text, label) {
            currentResult = text;
            document.getElementById('modal-label').innerText = label;
            document.getElementById('modal-original-text').innerText = currentOriginalInput || '';
            document.getElementById('modal-loading').classList.add('hidden');
            document.getElementById('modal-content').classList.remove('hidden');
            
            let parsedQuestions = null;
            try {
                if (text.startsWith('[') && text.endsWith(']')) {
                    parsedQuestions = JSON.parse(text);
                }
            } catch (e) {}

            if (parsedQuestions && Array.isArray(parsedQuestions) && parsedQuestions.length > 0) {
                // Show clarification UI
                const container = document.getElementById('modal-dynamic-questions');
                container.innerHTML = parsedQuestions.map((q, idx) => `
                    <div class="mb-3">
                        <label class="block text-slate-800 font-bold text-sm mb-1 ml-1">${q}</label>
                        <input type="text" id="clarification-answer-${idx}" data-question="${q.replace(/"/g, '&quot;')}" class="w-full bg-white border-2 border-amber-100 focus:border-amber-400 focus:ring-0 text-sm px-4 py-2.5 rounded-xl placeholder:text-slate-400 font-medium transition-all outline-none clarification-input" placeholder="${currentLang === 'ur' ? 'یہاں جواب دیں...' : 'Type your answer here...'}">
                    </div>
                `).join('');
                
                document.getElementById('modal-clarification').classList.remove('hidden');
                document.getElementById('modal-result-container').classList.add('hidden');
                
                // Hide main action buttons (Copy, Save, Remix) for clarification
                document.getElementById('copy-btn').parentElement.classList.add('hidden');
                document.getElementById('copy-formats-row').classList.add('hidden');
                document.getElementById('copy-formats-row').previousElementSibling.classList.add('hidden');
                document.getElementById('translate-btn').classList.add('hidden');
                document.getElementById('provider-section').classList.add('hidden');

                // Bind input listener to dynamically generated inputs
                document.querySelectorAll('.clarification-input').forEach((input, index) => {
                    input.addEventListener('input', () => {
                        const state = JSON.parse(sessionStorage.getItem('modal_state') || '{}');
                        if (!state.answers) state.answers = [];
                        state.answers[index] = input.value;
                        sessionStorage.setItem('modal_state', JSON.stringify(state));
                    });
                });

                // Save modal state
                sessionStorage.setItem('modal_state', JSON.stringify({
                    type: 'clarification',
                    text: text,
                    label: label,
                    originalInput: currentOriginalInput,
                    answers: []
                }));
            } else {
                // Show standard result UI
                document.getElementById('modal-text').innerText = text;
                document.getElementById('modal-clarification').classList.add('hidden');
                document.getElementById('modal-result-container').classList.remove('hidden');
                
                // Show main action buttons
                document.getElementById('copy-btn').parentElement.classList.remove('hidden');
                document.getElementById('copy-formats-row').classList.remove('hidden');
                document.getElementById('copy-formats-row').previousElementSibling.classList.remove('hidden');
                document.getElementById('translate-btn').classList.remove('hidden');
                document.getElementById('provider-section').classList.remove('hidden');
                
                const copyBtn = document.getElementById('copy-btn');
                copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> <span data-en="Copy" data-ur="کاپی">Copy</span>';
                copyBtn.className = 'py-4 bg-slate-900 text-white rounded-2xl font-extrabold hover:bg-black transition-all active:scale-95 flex items-center justify-center gap-2 shadow-xl shadow-slate-900/20';
                
                // Save modal state
                sessionStorage.setItem('modal_state', JSON.stringify({
                    type: 'result',
                    text: text,
                    label: label,
                    originalInput: currentOriginalInput
                }));
            }
            if (typeof globalApplyLang === 'function') globalApplyLang();
        }

        async function submitClarification() {
            const inputs = document.querySelectorAll('.clarification-input');
            let allEmpty = true;
            let qaText = '';
            
            inputs.forEach(input => {
                const ans = input.value.trim();
                if (ans) {
                    allEmpty = false;
                    qaText += `Q: ${input.dataset.question}\nA: ${ans}\n\n`;
                }
            });

            if (allEmpty) {
                showToast('⚠️', currentLang === 'ur' ? 'براہ کرم کم از کم ایک جواب فراہم کریں!' : 'Please provide at least one answer!', true);
                return;
            }
            
            const btn = document.getElementById('clarification-submit-btn');
            const originalHtml = btn.innerHTML;
            btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i>`;
            btn.disabled = true;
            
            // Combine context
            const combinedInput = `Original Idea: ${currentOriginalInput}\n\nUser Answers to Clarification Questions:\n${qaText}`;
            
            // Re-run generation with combined input
            document.getElementById('ai-input').value = combinedInput;
            closeModal();
            btn.innerHTML = originalHtml;
            btn.disabled = false;
            
            await enhanceCreation();
            
            // Reset input field back to original visual
            document.getElementById('ai-input').value = currentOriginalInput;
        }

        function setBtnLoading(btnId, isLoading, loadingText = 'Processing...') {
            const btn = document.getElementById(btnId);
            if (!btn) return;
            if (!btn.dataset.originalHtml) {
                btn.dataset.originalHtml = btn.innerHTML;
            }
            if (isLoading) {
                btn.disabled = true;
                btn.classList.add('opacity-70', 'cursor-not-allowed');
                btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>${loadingText}</span>`;
            } else {
                btn.disabled = false;
                btn.classList.remove('opacity-70', 'cursor-not-allowed');
                btn.innerHTML = btn.dataset.originalHtml;
                if (typeof globalApplyLang === 'function') globalApplyLang();
            }
        }

        // ═══ ENHANCE CREATION ═══
        async function enhanceCreation() {
            const inputVal = document.getElementById('ai-input').value.trim();
            if (!inputVal) {
                showToast('⚠️', currentLang === 'ur' ? 'پہلے اپنا خیال لکھیں!' : 'Please write your idea first!', true);
                return;
            }

            const type = document.getElementById('creation-type').value;
            const tone = document.getElementById('creation-tone').value;
            const level = document.getElementById('creation-level').value;
            const targetProvider = document.getElementById('target-provider').value;
            const projectId = document.getElementById('project-select')?.value || '';
            currentOriginalInput = inputVal;
            let memoryContext = '';

            if (projectId) {
                try {
                    const contextRes = await fetch(`/user/projects/${projectId}/context?limit=6`);
                    if (contextRes.ok) {
                        const contextRows = await contextRes.json();
                        if (Array.isArray(contextRows) && contextRows.length) {
                            const chunks = contextRows.map((row, idx) =>
                                `Q${idx + 1}: ${row.question_text}\nA${idx + 1}: ${row.answer_text}`
                            );
                            memoryContext = `\n\nPROJECT MEMORY CONTEXT:\n${chunks.join('\n\n')}\n\nUse this context for consistency with prior decisions.`;
                        }
                    }
                } catch (_) {}
            }

            setBtnLoading('enhance-btn', true, currentLang === 'ur' ? 'تیار ہو رہا ہے...' : 'Enhancing...');
            showLoading();

            try {
                const res = await fetch('/api', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ input: inputVal + memoryContext, type, lang: currentLang, tone, level })
                });
                const data = await res.json();
                if (!res.ok || data.error) {
                    if (res.status === 401) {
                        throw new Error(currentLang === 'ur' ? 'جاری رکھنے کے لیے براہ کرم سائن اِن کریں۔' : 'Please sign in to continue.');
                    }
                    if (res.status === 429) {
                        throw new Error(data.error || (currentLang === 'ur' ? 'آج کی حد مکمل ہو گئی۔ براہ کرم پلان اپ گریڈ کریں۔' : 'Daily limit reached. Please upgrade your plan.'));
                    }
                    throw new Error(data.error || (currentLang === 'ur' ? 'درخواست مکمل نہیں ہو سکی۔' : 'Could not complete your request.'));
                }

                const enhanced = data.text.trim();
                
                // Check if fallback was used and show beautiful notification
                if (data.fallbackUsed) {
                    const providerName = data.provider || 'Backup API';
                    showToast('🔄', currentLang === 'ur' 
                        ? `API 2 کامیابی سے لاگو ہو گیا! (${providerName})` 
                        : `API 2 implemented successfully! (${providerName})`, false);
                }
                
                showResult(enhanced, `${type.toUpperCase()} · ${tone} · ${level}`);

                if (projectId && enhanced) {
                    fetch(`/user/projects/${projectId}/context`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ question: inputVal, answer: enhanced })
                    }).catch(() => {});
                }

                // Save to history
                if (!isGuest) {
                    await fetch('/user/history', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ original: inputVal, enhanced, type })
                    });
                    renderHistory();
                }
                
                if (targetProvider !== 'none') {
                    setTimeout(() => deployToProvider(targetProvider), 1500);
                }

            } catch (e) {
                document.getElementById('modal-loading').classList.add('hidden');
                document.getElementById('modal-content').classList.remove('hidden');
                document.getElementById('modal-text').innerText = (currentLang === 'ur' ? '⚠️ مسئلہ: ' : '⚠️ ') + e.message;
            } finally {
                setBtnLoading('enhance-btn', false);
            }
        }

        function formatResultForCopy(format) {
            const labelText = document.getElementById('modal-label')?.innerText || 'Result';
            const typeVal = document.getElementById('creation-type')?.value || 'standard';
            const toneVal = document.getElementById('creation-tone')?.value || 'professional';
            const levelVal = document.getElementById('creation-level')?.value || 'standard';

            if (format === 'markdown') {
                return `## ${labelText}\n\n${currentResult}`;
            }
            if (format === 'json') {
                const payload = {
                    label: labelText,
                    type: typeVal,
                    tone: toneVal,
                    level: levelVal,
                    language: currentLang,
                    prompt: currentResult
                };
                return JSON.stringify(payload, null, 2);
            }
            return currentResult;
        }

        function copyResultAs(format = 'plain') {
            if (!currentResult) return;
            const textToCopy = formatResultForCopy(format);
            navigator.clipboard.writeText(textToCopy).then(() => {
                const formatNames = {
                    plain: currentLang === 'ur' ? 'سادہ' : 'Plain',
                    markdown: 'Markdown',
                    json: 'JSON'
                };
                showToast('📋', `${formatNames[format] || 'Plain'} ${currentLang === 'ur' ? 'کاپی ہو گیا!' : 'copied to clipboard!'}`);
            }).catch(() => {
                showToast('❌', currentLang === 'ur' ? 'کاپی نہیں ہو سکا۔' : 'Copy failed.', true);
            });
        }

        function copyResult() {
            if (!currentResult) return;
            navigator.clipboard.writeText(currentResult).then(() => {
                showToast('📋', currentLang === 'ur' ? 'کاپی ہو گیا!' : 'Copied to clipboard!');
            }).catch(() => {
                showToast('❌', currentLang === 'ur' ? 'کاپی نہیں ہو سکا۔' : 'Copy failed.', true);
            });
            const btn = document.getElementById('copy-btn');
            if (!btn) return;
            btn.innerHTML = '<i class="fa-solid fa-check"></i> <span>Copied!</span>';
            setTimeout(() => {
                btn.innerHTML = '<i class="fa-regular fa-copy"></i> <span data-en="Copy" data-ur="کاپی">Copy</span>';
                if (typeof globalApplyLang === 'function') globalApplyLang();
            }, 2000);
        }

        async function saveToFavorites() {
            if (isGuest) { showLoginNudge(); return; }
            if (!currentResult) return;
            setBtnLoading('save-btn', true, currentLang === 'ur' ? 'محفوظ ہو رہا ہے...' : 'Saving...');
            try {
                await fetch('/user/favorites', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ content: currentResult, title: document.getElementById('modal-label').innerText || 'My Creation', category: 'saved' })
                });
                showToast('🔖', currentLang === 'ur' ? 'محفوظ ہو گیا!' : 'Saved to Library!');
            } catch (e) { showToast('❌', 'Save failed!', true); }
            finally { setBtnLoading('save-btn', false); }
        }

        async function renderHistory() {
            const el = document.getElementById('history-list');
            if (!el) return;
            if (!isGuest) {
                const res = await fetch('/user/history');
                const data = await res.json();
                if (Array.isArray(data)) historyData = data;
            }
            if (!historyData.length) {
                el.innerHTML = '<p class="text-slate-300 text-sm font-semibold py-4">No history yet.</p>';
                return;
            }
            el.innerHTML = historyData.slice(0, 6).map(h => `
                <div class="creation-card" onclick='showResult(${JSON.stringify(h.enhanced_result || h.enhanced)}, "History")'>
                    <p class="text-[10px] font-bold text-slate-400 mb-1">${h.created_at || ''}</p>
                    <p class="font-extrabold text-slate-800 text-sm mb-1 line-clamp-1">${escH(h.original_input || h.original)}</p>
                </div>`).join('');
        }

        function deployToProvider(provider) {
            if (!currentResult) return;
            if (!canUseProFeatures) {
                showToast('🔒', currentLang === 'ur' ? 'یہ فیچر پرو پلان میں دستیاب ہے۔' : 'This feature is available on Pro plan only.', true);
                return;
            }
            navigator.clipboard.writeText(currentResult);
            const encoded = encodeURIComponent(currentResult);
            const providerUrls = {
                chatgpt: `https://chatgpt.com/?q=${encoded}`,
                claude: `https://claude.ai/new?q=${encoded}`,
                perplexity: `https://www.perplexity.ai/search?q=${encoded}`,
                grok: `https://x.com/i/grok?q=${encoded}`,
                gemini: `https://gemini.google.com/app?hl=en`
            };
            window.open(providerUrls[provider] || 'https://chatgpt.com/', '_blank');
        }

        function handleVoice() {
            if (!canUseProFeatures) {
                showToast('🔒', currentLang === 'ur' ? 'وائس فیچر کے لیے پرو پلان لیں۔' : 'Upgrade to Pro to use voice input.', true);
                return;
            }
            const Speech = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!Speech) { showToast('❌', 'Voice not supported.', true); return; }
            if (isRecording) { recognition?.stop(); return; }
            recognition = new Speech();
            recognition.lang = currentLang === 'ur' ? 'ur-PK' : 'en-US';
            recognition.onstart = () => {
                isRecording = true;
                document.getElementById('voice-btn').classList.add('recording');
                document.getElementById('rec-bar').classList.add('active');
            };
            recognition.onresult = e => {
                document.getElementById('ai-input').value += ' ' + e.results[0][0].transcript;
            };
            recognition.onend = () => {
                isRecording = false;
                document.getElementById('voice-btn').classList.remove('recording');
                document.getElementById('rec-bar').classList.remove('active');
            };
            recognition.start();
        }

        function handleAttachment() {
            if (!canUseProFeatures) {
                showToast('🔒', currentLang === 'ur' ? 'اٹیچمنٹ کے لیے پرو پلان ضروری ہے۔' : 'Upgrade to Pro to use attachments.', true);
                return;
            }
            document.getElementById('file-input').click();
        }
        function handleFileSelected(input) {
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('ai-input').value += `\n\n--- ${file.name} ---\n${e.target.result.substring(0, 2000)}`;
                showToast('📎', 'File attached!');
            };
            reader.readAsText(file);
        }

