    <script defer>
        // ═══ STATE ═══
        const isGuest = <%- typeof is_guest !== 'undefined' ? is_guest : 'true' %>;
        const subscriptionPlan = "<%= typeof subscription_plan !== 'undefined' ? subscription_plan : 'free' %>";
        const subscriptionStatus = "<%= typeof subscription_status !== 'undefined' ? subscription_status : 'inactive' %>";
        const activePaidStatuses = ['active', 'trialing', 'past_due'];
        const hasPaidAccess = activePaidStatuses.includes(String(subscriptionStatus || '').toLowerCase());
        const accessTier = isGuest ? 'guest' : (hasPaidAccess ? String(subscriptionPlan || 'free').toLowerCase() : 'free');
        const canUseProFeatures = accessTier === 'pro' || accessTier === 'plus';
        const canUseCopyFormats = true;
        const canUseProjectMemory = accessTier === 'plus';

                let currentResult = '';
        let currentOriginalInput = '';
        let currentLang = localStorage.getItem('preferred_lang') || 'en';
        let isRecording = false;
        let recognition = null;
        let currentCat = 'all';
        let historyData = JSON.parse(localStorage.getItem('np_history') || '[]');

        // ═══ INSPIRATION CARDS DATA ═══
        const inspirations = [
            { cat: 'text', icon: 'fa-envelope', title: 'Professional Email', title_ur: 'پیشہ ورانہ ای میل', label: 'Writing', label_ur: 'تحریر', color: 'text-blue-600', bg: 'bg-blue-50', type: 'writing', tone: 'professional',
              input: 'Write a clear, professional email. Include a warm greeting, clear purpose in the subject, key message in bullet points, a polite call to action, and formal sign-off. Placeholders: [Name], [Subject], [Context].' },
            { cat: 'text', icon: 'fa-file-signature', title: 'Cover Letter', title_ur: 'کور لیٹر', label: 'Writing', label_ur: 'تحریر', color: 'text-indigo-600', bg: 'bg-indigo-50', type: 'writing', tone: 'professional',
              input: 'Write a compelling cover letter for [Job Title] at [Company]. Open with a strong hook. Highlight 3 achievements with metrics. Close with a confident CTA. Under 300 words. No clichés.' },
            { cat: 'business', icon: 'fa-handshake', title: 'Sales Pitch', title_ur: 'سیلز پچ', label: 'Business', label_ur: 'کاروبار', color: 'text-amber-600', bg: 'bg-amber-50', type: 'planning', tone: 'persuasive',
              input: 'Using the PAS framework, write a B2B sales pitch for [Product]: (1) pain-point hook, (2) agitate the cost, (3) unique value prop, (4) 3 specific benefits with metrics, (5) social proof, (6) low-friction CTA.' },
            { cat: 'image', icon: 'fa-image', title: 'Cinematic Portrait', title_ur: 'سنیما پورٹریٹ', label: 'Image', label_ur: 'تصویر', color: 'text-rose-600', bg: 'bg-rose-50', type: 'image', tone: 'creative',
              input: 'Cinematic portrait of [subject], golden hour lighting, 85mm lens bokeh, ARRI Alexa footage grade, shallow depth of field, hyper-realistic skin texture, award-winning photography, Vogue magazine aesthetic.' },
            { cat: 'code', icon: 'fa-code', title: 'Feature Builder', title_ur: 'فیچر بلڈر', label: 'Code', label_ur: 'کوڈ', color: 'text-teal-600', bg: 'bg-teal-50', type: 'code', tone: 'technical',
              input: 'You are a senior [Language] developer. Build a [Feature] with: clean architecture, error handling, input validation, unit tests, and inline JSDoc comments. Return: implementation code, integration guide, list of edge cases handled.' },
        ];

        // ═══ TEMPLATES ═══
        const templates = [
            { icon: 'fa-rocket', title_en: 'Build SaaS Idea', title_ur: 'SaaS آئیڈیا بنائیں', type_en: 'Planning', type_ur: 'منصوبہ بندی', type: 'planning', tone: 'professional',
              input: 'Act as a startup strategist. Turn this SaaS concept into an execution plan: target persona, painful problem, unique value proposition, MVP features, pricing model, acquisition channels, 90-day roadmap, and launch risks with mitigation.' },
            { icon: 'fa-bug', title_en: 'Fix Code Bug', title_ur: 'کوڈ بگ ٹھیک کریں', type_en: 'Code', type_ur: 'کوڈ', type: 'code', tone: 'technical',
              input: 'Act as a senior debugging engineer. Analyze this bug step-by-step, identify likely root causes, suggest a minimal fix first, then provide a robust fix with validation checks, regression tests, and final corrected code.' },
            { icon: 'fa-linkedin', title_en: 'Write LinkedIn Post', title_ur: 'LinkedIn پوسٹ لکھیں', type_en: 'Writing', type_ur: 'تحریر', type: 'writing', tone: 'professional',
              input: 'Write a high-performing LinkedIn post with: strong first-line hook, story + insight, one actionable takeaway, concise style, and a natural CTA for comments. Keep it authentic and professional.' },
        ];

        // ═══ RENDER CARDS ═══
        function renderCards() {
            const grid = document.getElementById('cards-grid');
            const isUrdu = currentLang === 'ur';
            const search = (document.getElementById('search-input')?.value || '').toLowerCase();
            const filtered = inspirations.filter(p => {
                const matchesCat = currentCat === 'all' || p.cat === currentCat;
                const matchesSearch = !search || (p.title + p.title_ur + p.label).toLowerCase().includes(search);
                return matchesCat && matchesSearch;
            });
            if (!filtered.length) {
                grid.innerHTML = '<p class="text-slate-300 text-sm col-span-2 py-8 text-center font-semibold">No results found.</p>';
                return;
            }
            grid.innerHTML = filtered.map(p => `
                <div class="creation-card" onclick="loadCard(${JSON.stringify(p.input).replace(/</g,'\\u003c')}, '${p.type}', '${p.tone}')">
                    <div class="flex items-start gap-3 mb-3">
                        <div class="w-10 h-10 rounded-xl ${p.bg} ${p.color} flex items-center justify-center flex-shrink-0 text-base">
                            <i class="fa-solid ${p.icon}"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-extrabold text-slate-900 text-sm leading-tight">${isUrdu ? p.title_ur : p.title}</h4>
                            <span class="text-[10px] font-bold ${p.color} uppercase tracking-wider">${isUrdu ? p.label_ur : p.label}</span>
                        </div>
                    </div>
                    <p class="text-slate-400 text-xs font-medium line-clamp-2 leading-relaxed">${p.input.substring(0, 100)}...</p>
                </div>
            `).join('');
        }

        function loadCard(input, type, tone) {
            document.getElementById('ai-input').value = input;
            if (type) document.getElementById('creation-type').value = type;
            if (tone) document.getElementById('creation-tone').value = tone;
            setTab('create');
            document.getElementById('ai-input').focus();
            showToast('✨', currentLang === 'ur' ? 'ڈیٹا لوڈ ہو گیا!' : 'Idea loaded! Now click Enhance.');
        }

        // ═══ RENDER TEMPLATES ═══
        function renderTemplates() {
            const grid = document.getElementById('template-grid');
            const isUrdu = currentLang === 'ur';
            grid.innerHTML = templates.map((t, i) => `
                <div class="template-card" id="tpl-${i}" onclick="loadTemplate(${i})">
                    <div class="flex items-center gap-3 mb-2">
                        <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600">
                            <i class="fa-solid ${t.icon}"></i>
