<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Profile | NeuroMagic</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/jameel-noori@1.1.2/jameel-noori.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Outfit', 'sans-serif'], urdu: ['Jameel Noori Nastaleeq', 'sans-serif'] },
                }
            }
        }
    </script>
    <style>
        body { background-color: #fcfcfd; font-family: 'Inter', sans-serif; transition: all 0.3s ease; }
        .display-font { font-family: 'Outfit', sans-serif; }
        [dir="rtl"] { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; font-size: 1.1rem !important; text-align: right !important; }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; font-size: 1.2rem !important; }
        [dir="rtl"] .lg\:ml-64 { margin-left: 0 !important; margin-right: 16rem !important; }
    </style>
    
</head>
<body class="antialiased text-slate-900 pb-24 lg:pb-0">
    <%- include('../partials/sidebar') %>
    
    <main class="lg:ml-64 min-h-screen hero-gradient flex flex-col items-center py-6 lg:py-12 px-6 transition-all duration-300 rtl:ml-0 rtl:mr-64">
        
        <div class="w-full flex justify-end mb-6">
            <button onclick="toggleLang()" class="text-xs font-bold text-slate-500 bg-white border border-slate-100 px-4 py-3 rounded-xl hover:bg-slate-50 hover:text-slate-900 transition-all flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-earth-asia"></i> <span id="lang-label">EN / اردو</span>
            </button>
        </div>
        
        <div class="w-full max-w-2xl bg-white border border-slate-100 rounded-[40px] p-10 shadow-2xl shadow-blue-500/5 text-center">
            
            <div class="relative inline-block mb-8">
                <div class="w-28 h-28 rounded-full bg-gradient-to-tr from-blue-500 to-indigo-600 flex items-center justify-center text-white font-bold text-4xl shadow-xl border-4 border-white">
                    <%= typeof user_name !== 'undefined' ? user_name.substring(0, 1).toUpperCase() : 'U' %>
                </div>
            </div>
            <p class="text-slate-400 font-medium mb-10"><%= typeof user_email !== 'undefined' ? user_email : 'user@example.com' %></p>
        </div>
        
        <!-- Profile Edit Form -->
        <div class="w-full max-w-2xl bg-white border border-slate-100 rounded-[40px] p-10 shadow-2xl shadow-blue-500/5 text-center mt-8">
            <h2 class="text-2xl font-bold text-slate-800 mb-6" data-en="Edit Profile" data-ur="پروفائل میںں">Edit Profile</h2>
            
            <form id="profile-form" class="space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2" data-en="Name" data-ur="نام">Name</label>
                        <input type="text" id="name" name="name" value="<%= typeof user_name !== 'undefined' ? user_name : '' %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-2" data-en="Email" data-ur="ایمیل">Email</label>
                        <input type="email" id="email" name="email" value="<%= typeof user_email !== 'undefined' ? user_email : '' %>" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                    </div>
                </div>
                
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-2" data-en="Current Password" data-ur="پاس ورڈ">Current Password</label>
                    <input type="password" id="current_password" name="current_password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent" placeholder="Leave blank to keep current">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-2" data-en="New Password" data-ur="نیا پاس ورڈ">New Password</label>
                    <input type="password" id="new_password" name="new_password" class="w-full px-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                </div>
                
                <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-blue-700 transition-colors">
                    <span data-en="Update Profile" data-ur="پروفائل میںں">Update Profile</span>
                </button>
            </form>
        </div>
        
        <div class="grid grid-cols-3 gap-4 mb-10 stats-container">
            <div class="bg-slate-50 p-4 rounded-2xl">
                <div class="text-2xl font-bold display-font"><%= stats.creations %></div>
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" data-en="Masterpieces" data-ur="شاہکار">Masterpieces</div>
            </div>
            <div class="bg-slate-50 p-4 rounded-2xl">
                <div class="text-2xl font-bold display-font"><%= stats.favorites %></div>
                <div class="text-[10px] font-bold text-slate-400 uppercase tracking-widest" data-en="Favorites" data-ur="پسندیدہ">Favorites</div>
            </div>
        </div>
    </main>

<script src="https://cdn.tailwindcss.com"></script>
<script>
        
        
    // Profile Edit Functionality
    document.getElementById('profile-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const formData = new FormData(e.target);
        const data = {};
        for (let [key, value] of formData.entries()) {
            data[key] = value;
        }
        
        try {
            const response = await fetch('/user/profile', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            
            if (result.success) {
                // Show success message
                const successMsg = result.message || 'Profile updated successfully';
                alert(successMsg);
                
                // Reload page after successful update
                setTimeout(() => {
                    window.location.reload();
                }, 1000);
            } else {
                // Show error message
                const errorMsg = result.error || 'Failed to update profile';
                alert(errorMsg);
            }
        } catch (error) {
            console.error('Profile update error:', error);
            alert('Error updating profile. Please try again.');
        }
    });
</script>
</body>
</html>
