    <%- include('../partials/bottom_nav') %>

    <div id="notice" class="hidden fixed bottom-6 right-6 z-[1200] max-w-sm w-[92vw] sm:w-full rounded-2xl border px-4 py-3 shadow-2xl bg-white">
        <div class="flex items-start gap-3">
            <div id="notice-icon" class="w-8 h-8 rounded-xl bg-blue-100 text-blue-700 flex items-center justify-center flex-shrink-0">
                <i class="fa-solid fa-circle-info"></i>
            </div>
            <div class="min-w-0">
                <p id="notice-title" class="font-extrabold text-slate-900 text-sm">Notice</p>
                <p id="notice-message" class="text-xs text-slate-500 font-medium mt-1">Message</p>
            </div>
        </div>
    </div>

    <script>
        function applyLang() {
            if (typeof globalApplyLang === 'function') {
                globalApplyLang();
            }
        }

        async function parseApiResponse(response) {
            const contentType = response.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
                return response.json();
            }
            const text = await response.text();
            if (text.startsWith('<!DOCTYPE') || text.startsWith('<html')) {
                throw new Error('Please sign in to continue.');
            }
            throw new Error(text || 'Unexpected server response');
        }

        function showNotice(type, title, message) {
            const notice = document.getElementById('notice');
            const icon = document.getElementById('notice-icon');
            const titleEl = document.getElementById('notice-title');
            const msgEl = document.getElementById('notice-message');
            if (!notice || !icon || !titleEl || !msgEl) return;

            const palette = {
                success: ['bg-emerald-100 text-emerald-700', 'fa-solid fa-circle-check'],
                error: ['bg-rose-100 text-rose-700', 'fa-solid fa-triangle-exclamation'],
                info: ['bg-blue-100 text-blue-700', 'fa-solid fa-circle-info']
            };
            const [iconClasses, iconName] = palette[type] || palette.info;
            icon.className = `w-8 h-8 rounded-xl flex items-center justify-center flex-shrink-0 ${iconClasses}`;
            icon.innerHTML = `<i class="${iconName}"></i>`;
            titleEl.textContent = title;
            msgEl.textContent = message;
            notice.classList.remove('hidden');
            clearTimeout(window.noticeTimer);
            window.noticeTimer = setTimeout(() => notice.classList.add('hidden'), 4200);
        }

        async function startCheckout(plan, button) {
            const originalText = button.textContent;
            button.disabled = true;
            button.textContent = 'Redirecting...';
            try {
                const response = await fetch('/billing/checkout-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ plan })
                });
                const data = await parseApiResponse(response);
                if (!response.ok || !data.url) throw new Error(data.error || 'Failed to create checkout session');
                window.location.href = data.url;
            } catch (err) {
                showNotice('error', 'Checkout failed', err.message || 'Could not start checkout.');
                button.disabled = false;
                button.textContent = originalText;
            }
        }

        async function openBillingPortal() {
            try {
                const response = await fetch('/billing/customer-portal', { method: 'POST' });
                const data = await parseApiResponse(response);
                if (!response.ok || !data.url) throw new Error(data.error || 'Could not open billing portal');
                window.location.href = data.url;
            } catch (err) {
                showNotice('error', 'Billing unavailable', err.message || 'Billing portal unavailable.');
            }
        }

        async function updatePlanState() {
            try {
                const response = await fetch('/billing/status');
                if (!response.ok) return;
                const status = await parseApiResponse(response);
                const activePlan = status.plan || 'free';
                const buttons = document.querySelectorAll('.subscribe-btn');
                buttons.forEach((button) => {
                    if (button.dataset.plan === activePlan && ['active', 'trialing', 'past_due', 'pending'].includes(status.status)) {
                        button.textContent = 'Current Plan';
                        button.disabled = true;
                        button.classList.add('opacity-70', 'cursor-not-allowed');
                    }
                });

                if (status.status && status.status !== 'inactive') {
                    const wrap = document.createElement('div');
                    wrap.className = 'mt-8';
                    wrap.innerHTML = '<button id="manage-subscription-btn" class="py-3 px-6 rounded-xl bg-slate-900 text-white font-semibold hover:bg-slate-700 transition-all">Manage Subscription</button>';
                    document.querySelector('main').appendChild(wrap);
                    document.getElementById('manage-subscription-btn').addEventListener('click', openBillingPortal);
                }
            } catch (_) {}
        }

        async function updateFreeUsageBanner() {
            try {
                const response = await fetch('/user/dashboard-data');
                const data = await parseApiResponse(response);
                if (!response.ok) return;
                const isLimited = Boolean(data?.usage?.isLimited);
                const usedToday = Number(data?.usage?.usedToday || 0);
                const limit = Number(data?.usage?.dailyLimit || 40);
                const banner = document.getElementById('free-usage-banner');
                const text = document.getElementById('free-usage-text');
                if (!banner || !text) return;
                if (isLimited) {
                    text.textContent = `Free usage: ${usedToday}/${limit} today`;
                    banner.classList.remove('hidden');
                } else {
                    text.textContent = `Unlimited usage on ${(data?.subscription?.plan || 'pro').toUpperCase()} plan`;
                }
            } catch (_) {}
        }

        document.querySelectorAll('.subscribe-btn').forEach((button) => {
            button.addEventListener('click', () => startCheckout(button.dataset.plan, button));
        });

        async function confirmCheckoutFromUrl() {
            const params = new URLSearchParams(window.location.search);
            const checkoutState = params.get('checkout');
            const sessionId = params.get('session_id');
            if (checkoutState !== 'success' || !sessionId) return;
            try {
                const response = await fetch('/billing/confirm-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ sessionId })
                });
                const data = await parseApiResponse(response);
                if (!response.ok || !data.success) throw new Error(data.error || 'Could not confirm payment');
                params.delete('session_id');
                const qs = params.toString();
                const cleanUrl = qs ? `${window.location.pathname}?${qs}` : window.location.pathname;
                window.history.replaceState({}, '', cleanUrl);
                showNotice('success', 'Subscription active', 'Your plan is now active and ready to use.');
                
                // Trigger Confetti Celebration
                const duration = 4000;
                const end = Date.now() + duration;
                const colors = ['#3b82f6', '#10b981', '#f59e0b', '#ec4899', '#8b5cf6'];
                
                (function frame() {
                    confetti({
                        particleCount: 5,
                        angle: 60,
                        spread: 55,
                        origin: { x: 0 },
                        colors: colors,
                        zIndex: 1000
                    });
                    confetti({
                        particleCount: 5,
                        angle: 120,
                        spread: 55,
                        origin: { x: 1 },
                        colors: colors,
                        zIndex: 1000
                    });
                    if (Date.now() < end) {
                        requestAnimationFrame(frame);
                    }
                }());

            } catch (err) {
                showNotice('error', 'Confirmation issue', err.message || 'Payment succeeded but confirmation failed. Please refresh.');
            }
        }

        confirmCheckoutFromUrl();
        updatePlanState();
        updateFreeUsageBanner();
        window.onload = applyLang;
        window.addEventListener('languageChanged', applyLang);
    </script>
</body>
</html>
