                <button id="pro-btn" data-plan="pro" class="subscribe-btn w-full py-4 bg-blue-600 text-white rounded-2xl font-bold hover:bg-blue-700 transition-all active:scale-95 shadow-xl shadow-blue-500/20" data-en="Upgrade to Pro" data-ur="پرو پر اپ گریڈ کریں">Upgrade to Pro</button>
