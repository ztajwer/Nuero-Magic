    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','sans-serif'],display:['Outfit','sans-serif'],urdu:['Jameel Noori Nastaleeq','sans-serif']}}}}</script>
    <style>
        body { background: #fcfcfd; font-family: 'Inter', sans-serif; transition: all 0.3s ease; }
        .display-font { font-family: 'Outfit', sans-serif; }
        .hero-gradient { background: radial-gradient(circle at 50% -20%, rgba(59, 130, 246, 0.05) 0%, rgba(252, 252, 253, 1) 70%); }
        
        /* RTL */
        [dir="rtl"] { font-family: 'Jameel Noori Nastaleeq', serif !important; font-size: 1.1rem !important; text-align: right !important; }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', serif !important; font-size: 1.2rem !important; }
        [dir="rtl"] h1, [dir="rtl"] h2, [dir="rtl"] h3, [dir="rtl"] h4, [dir="rtl"] p, [dir="rtl"] span, [dir="rtl"] input, [dir="rtl"] button { font-family: 'Jameel Noori Nastaleeq', serif !important; text-align: right !important; }
        [dir="rtl"] .lg\:ml-64 { margin-left: 0 !important; margin-right: 16rem !important; }

        .plan-card { transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); border: 2px solid transparent; }
        .plan-card:hover { transform: translateY(-8px); border-color: #3b82f6; box-shadow: 0 30px 60px rgba(59, 130, 246, 0.1); }
        .plan-card.active { border-color: #3b82f6; background: #fff; }
        
        .check-icon { color: #10b981; }
    </style>
    
</head>
