<!DOCTYPE html>
<html lang="en" id="html-root">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magic History | NeuroMagic</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/jameel-noori@1.1.2/jameel-noori.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config = { theme: { extend: { fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Outfit', 'sans-serif'], urdu: ['Jameel Noori Nastaleeq', 'sans-serif'] } } } }</script>
    <style>
        body {
            background: #fcfcfd;
            font-family: 'Inter', sans-serif;
        }

        .display-font {
            font-family: 'Outfit', sans-serif;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* RTL */
        [dir="rtl"] {
            font-family: 'Jameel Noori Nastaleeq', serif !important;
            font-size: 1.1rem !important;
            text-align: right !important;
        }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', serif !important; font-size: 1.2rem !important; }
        [dir="rtl"] h1, [dir="rtl"] h2, [dir="rtl"] h3, [dir="rtl"] h4, [dir="rtl"] p, [dir="rtl"] span, [dir="rtl"] input, [dir="rtl"] button { font-family: 'Jameel Noori Nastaleeq', serif !important; text-align: right !important; }

        [dir="rtl"] .lg\:ml-64 {
            margin-left: 0 !important;
            margin-right: 16rem !important;
        }

        /* History Card */
        .history-card {
            background: #fff;
            border: 1.5px solid #f1f5f9;
            border-radius: 24px;
            padding: 24px;
            transition: all .3s cubic-bezier(.16, 1, .3, 1);
            position: relative;
            overflow: hidden;
        }

        .history-card:hover {
            border-color: #3b82f6;
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(59, 130, 246, 0.06);
        }

        .history-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: #3b82f6;
            opacity: 0;
            transition: opacity .3s;
        }

        .history-card:hover::before {
            opacity: 1;
        }

        .cat-pill {
            cursor: pointer;
            transition: all .2s;
            white-space: nowrap;
        }

        .cat-pill.active {
            background: #0f172a !important;
            color: #fff !important;
            border-color: #0f172a !important;
        }

        /* Modal */
        #modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, .65);
            backdrop-filter: blur(8px);
            z-index: 1000;
            align-items: flex-start;
            justify-content: center;
            padding: 20px;
            overflow-y: auto;
        }

        #modal-overlay.show {
            display: flex;
        }

        #modal-box {
            background: #fff;
            border-radius: 32px;
            padding: 40px;
            width: 100%;
            max-width: 700px;
            position: relative;
            margin: auto;
            animation: popIn .3s cubic-bezier(.16, 1, .3, 1);
        }

        @keyframes popIn {
            from {
                transform: scale(.92);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        /* Deletion Animation */
        .deleting {
            transform: scale(0.9);
            opacity: 0;
            transition: all 0.4s ease;
        }

        /* Toast */
        #toast {
            position: fixed;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%) translateY(80px);
            background: #0f172a;
            color: #fff;
            padding: 14px 24px;
            border-radius: 100px;
            font-weight: 700;
            font-size: 14px;
            z-index: 9999;
            transition: all .4s cubic-bezier(.16, 1, .3, 1);
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        #toast.show {
            transform: translateX(-50%) translateY(0);
        }
    </style>
    
</head>

<body class="antialiased text-slate-900">

    <%- include('../partials/sidebar') %>

        <main class="lg:ml-64 min-h-screen">
            <!-- Header -->
            <header
                class="sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-100 px-6 py-5 flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <a href="/user/enhance-creation"
                        class="w-10 h-10 rounded-full bg-slate-50 flex items-center justify-center text-slate-400 hover:text-slate-900 hover:bg-slate-100 transition-all">
                        <i class="fa-solid fa-arrow-left text-sm"></i>
                    </a>
                    <h1 class="text-xl font-extrabold display-font tracking-tight" data-en="Magic History"
                        data-ur="جادوئی سرگزشت">Magic History</h1>
                </div>

                <button onclick="confirmClearAll()"
                    class="text-xs font-bold text-red-500 bg-red-50 px-4 py-2 rounded-xl hover:bg-red-100 transition-all flex items-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> <span data-en="Clear All" data-ur="سب صاف کریں">Clear
                        All</span>
                </button>
            </header>

            <div class="max-w-5xl mx-auto px-6 py-10">

                <!-- Filter Bar -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
                    <div class="relative flex-1 max-w-md">
                        <i
                            class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-300"></i>
                        <input id="search-input" oninput="debounceFetch()" type="text"
                            data-placeholder-en="Search in your history..."
                            data-placeholder-ur="اپنی سرگزشت میں تلاش کریں..." placeholder="Search in your history..."
                            class="w-full pl-12 pr-4 py-4 bg-white border-2 border-slate-100 rounded-2xl text-sm focus:outline-none focus:border-blue-500 transition-all shadow-sm font-medium">
                    </div>

                    <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1">
                        <button onclick="setFilter(this, 'all')"
                            class="cat-pill active px-5 py-2.5 rounded-xl border-2 border-slate-100 bg-white text-slate-600 font-bold text-xs"><span
                                data-en="All" data-ur="سب">All</span></button>
                        <button onclick="setFilter(this, 'writing')"
                            class="cat-pill px-5 py-2.5 rounded-xl border-2 border-slate-100 bg-white text-slate-600 font-bold text-xs"><span
                                data-en="Writing" data-ur="تحریر">Writing</span></button>
                        <button onclick="setFilter(this, 'code')"
                            class="cat-pill px-5 py-2.5 rounded-xl border-2 border-slate-100 bg-white text-slate-600 font-bold text-xs"><span
                                data-en="Code" data-ur="کوڈ">Code</span></button>
                        <button onclick="setFilter(this, 'image')"
                            class="cat-pill px-5 py-2.5 rounded-xl border-2 border-slate-100 bg-white text-slate-600 font-bold text-xs"><span
                                data-en="Image" data-ur="تصویر">Image</span></button>
                    </div>
                </div>

                <!-- History List -->
                <div id="history-container" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Items injected here -->
                    <div class="col-span-full py-20 flex flex-col items-center justify-center text-center">
                        <div
                            class="w-20 h-20 bg-slate-50 text-slate-200 rounded-3xl flex items-center justify-center text-3xl mb-4">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <p class="text-slate-400 font-bold" data-en="Fetching your magic..."
                            data-ur="آپ کا جادو تلاش کیا جا رہا ہے...">Fetching your magic...</p>
                    </div>
                </div>
            </div>
        </main>

        <!-- Detail Modal -->
        <div id="modal-overlay" onclick="if(event.target===this)closeModal()">
            <div id="modal-box">
                <button onclick="closeModal()"
                    class="absolute top-6 right-6 w-10 h-10 bg-slate-50 rounded-full flex items-center justify-center text-slate-400 hover:text-slate-900 transition-all">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>

                <div class="flex items-center gap-4 mb-8">
                    <div id="modal-cat-icon"
                        class="w-14 h-14 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </div>
                    <div>
                        <span id="modal-cat-name"
                            class="text-[10px] font-extrabold text-blue-600 uppercase tracking-widest">Writing</span>
                        <h2 class="text-2xl font-extrabold display-font" data-en="Creation Details"
                            data-ur="تخلیق کی تفصیلات">Creation Details</h2>
                    </div>
                </div>

                <div class="space-y-8">
                    <div>
                        <label class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest mb-3 block"
                            data-en="Your Original Thought" data-ur="آپ کا اصل خیال">Your Original Thought</label>
                        <div class="p-5 bg-slate-50 rounded-2xl text-slate-700 font-medium text-sm leading-relaxed border border-slate-100 italic"
                            id="modal-original"></div>
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-3">
                            <label class="text-[10px] font-extrabold text-slate-400 uppercase tracking-widest"
                                data-en="The Magic Result" data-ur="جادوئی نتیجہ">The Magic Result</label>
                            <button onclick="copyModalResult()"
                                class="text-xs font-bold text-blue-600 flex items-center gap-1.5 hover:underline">
                                <i class="fa-regular fa-copy"></i> <span data-en="Copy" data-ur="کاپی">Copy</span>
                            </button>
                        </div>
                        <div class="p-6 bg-blue-50/50 rounded-3xl text-slate-900 font-semibold text-base leading-relaxed border border-blue-100 whitespace-pre-wrap"
                            id="modal-enhanced"></div>
                    </div>
                </div>

                <div class="mt-10 flex gap-3">
                    <button id="modal-remix-btn"
                        class="flex-1 py-4 bg-slate-900 text-white rounded-2xl font-bold hover:bg-black transition-all active:scale-95 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-rotate-right text-xs"></i> <span data-en="Remix This"
                            data-ur="دوبارہ بنائیں">Remix This</span>
                    </button>
                    <button id="modal-delete-btn"
                        class="w-14 h-14 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center hover:bg-red-100 transition-all">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toast -->
        <div id="toast">
            <i id="toast-icon" class="fa-solid fa-check text-green-400"></i>
            <span id="toast-msg">Action successful!</span>
        </div>

        <%- include('../partials/bottom_nav') %>

            <script>
                let currentFilter = 'all';
                let debounceTimer;
                let currentHistory = [];

                async function fetchHistory() {
                    const search = document.getElementById('search-input').value;
                    const container = document.getElementById('history-container');

                    try {
                        const res = await fetch(`/user/history?type=${currentFilter}&search=${encodeURIComponent(search)}`);
                        const data = await res.json();
                        currentHistory = data;
                        renderHistory(data);
                    } catch (e) {
                        console.error(e);
                    }
                }

                function renderHistory(items) {
                    const container = document.getElementById('history-container');
                    if (!items.length) {
                        container.innerHTML = `
                    <div class="col-span-full py-20 flex flex-col items-center justify-center text-center">
                        <p class="text-slate-400 font-bold" data-en="No history found matching your filters." data-ur="آپ کے فلٹرز کے مطابق کوئی ریکارڈ نہیں ملا۔">No history found matching your filters.</p>
                    </div>`;
                        return;
                    }

                    container.innerHTML = items.map(item => `
                <div class="history-card" id="card-${item.id}" onclick="openDetail(${item.id})">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-slate-50 text-slate-400 flex items-center justify-center text-sm">
                                <i class="fa-solid ${getIcon(item.creation_type)}"></i>
                            </div>
                            <div>
                                <span class="text-[10px] font-extrabold text-blue-600 uppercase tracking-widest">${item.creation_type || 'Standard'}</span>
                                <p class="text-[10px] font-bold text-slate-400">${new Date(item.created_at).toLocaleDateString()}</p>
                            </div>
                        </div>
                        <button onclick="event.stopPropagation(); deleteItem(${item.id})" class="w-8 h-8 rounded-lg text-slate-300 hover:text-red-500 hover:bg-red-50 transition-all">
                            <i class="fa-solid fa-trash-can text-xs"></i>
                        </button>
                    </div>
                    <h3 class="font-bold text-slate-900 text-sm mb-3 line-clamp-2 leading-relaxed">${escH(item.original_input)}</h3>
                    <p class="text-slate-400 text-xs font-medium line-clamp-3 leading-relaxed">${escH(item.enhanced_result)}</p>
                </div>
            `).join('');

                    if (window.globalApplyLang) window.globalApplyLang();
                }

                function getIcon(type) {
                    const icons = { writing: 'fa-file-pen', code: 'fa-code', image: 'fa-image', research: 'fa-magnifying-glass' };
                    return icons[type] || 'fa-wand-magic-sparkles';
                }

                function setFilter(btn, filter) {
                    currentFilter = filter;
                    document.querySelectorAll('.cat-pill').forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    fetchHistory();
                }

                function debounceFetch() {
                    clearTimeout(debounceTimer);
                    debounceTimer = setTimeout(fetchHistory, 400);
                }

                function openDetail(id) {
                    const item = currentHistory.find(h => h.id === id);
                    if (!item) return;

                    document.getElementById('modal-cat-name').innerText = item.creation_type;
                    document.getElementById('modal-original').innerText = item.original_input;
                    document.getElementById('modal-enhanced').innerText = item.enhanced_result;

                    document.getElementById('modal-remix-btn').onclick = () => remixItem(item);
                    document.getElementById('modal-delete-btn').onclick = () => { closeModal(); deleteItem(item.id); };

                    document.getElementById('modal-overlay').classList.add('show');
                    document.body.style.overflow = 'hidden';
                }

                function closeModal() {
                    document.getElementById('modal-overlay').classList.remove('show');
                    document.body.style.overflow = '';
                }

                async function deleteItem(id) {
                    if (!confirm('Are you sure you want to delete this creation?')) return;

                    const card = document.getElementById(`card-${id}`);
                    if (card) card.classList.add('deleting');

                    try {
                        const res = await fetch(`/user/history/${id}`, { method: 'DELETE' });
                        const data = await res.json();
                        if (data.success) {
                            showToast('🗑️', 'Item deleted');
                            setTimeout(fetchHistory, 400);
                        }
                    } catch (e) {
                        showToast('❌', 'Delete failed');
                        if (card) card.classList.remove('deleting');
                    }
                }

                async function confirmClearAll() {
                    if (!confirm('WARNING: This will permanently delete ALL your magic history. Are you sure?')) return;
                    try {
                        const res = await fetch('/user/history-all', { method: 'DELETE' });
                        const data = await res.json();
                        if (data.success) {
                            showToast('💥', 'History cleared');
                            fetchHistory();
                        }
                    } catch (e) {
                        showToast('❌', 'Failed to clear');
                    }
                }

                function copyModalResult() {
                    const text = document.getElementById('modal-enhanced').innerText;
                    navigator.clipboard.writeText(text);
                    showToast('📋', 'Copied!');
                }

                function remixItem(item) {
                    // Store in sessionStorage and redirect
                    sessionStorage.setItem('remix_input', item.original_input);
                    sessionStorage.setItem('remix_type', item.creation_type);
                    window.location.href = '/user/enhance-creation';
                }

                function showToast(icon, msg) {
                    const toast = document.getElementById('toast');
                    document.getElementById('toast-msg').innerText = msg;
                    toast.classList.add('show');
                    setTimeout(() => toast.classList.remove('show'), 3000);
                }

                function escH(str) { return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

                window.onload = fetchHistory;
            </script>
</body>

</html>