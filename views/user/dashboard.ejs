<!DOCTYPE html>
<html lang="en" id="html-root" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | NeuroMagic</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/jameel-noori@1.1.2/jameel-noori.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                        urdu: ['Jameel Noori Nastaleeq', 'serif'],
                    },
                    colors: {
                        primary: { 50: '#eff6ff', 100: '#dbeafe', 200: '#bfdbfe', 300: '#93c5fd', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 800: '#1e40af', 900: '#1e3a8a', 950: '#172554' }
                    },
                    boxShadow: {
                        'premium': '0 4px 20px -2px rgba(15, 23, 42, 0.03)',
                        'premium-hover': '0 20px 40px -4px rgba(15, 23, 42, 0.08)',
                    }
                },
            },
        };
    </script>
    <style>
        body { background: #fcfcfc; font-family: 'Inter', sans-serif; transition: all 0.3s ease; }
        .display-font { font-family: 'Outfit', sans-serif; }
        [dir="rtl"] { font-family: 'Jameel Noori Nastaleeq', serif !important; font-size: 1.15rem !important; text-align: right !important; }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', serif !important; }
        [dir="rtl"] .ltr-only { direction: ltr; unicode-bidi: plaintext; }
        @media (max-width: 1023px) { body { padding-bottom: 80px; } }
        
        .premium-card {
            background: #ffffff;
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 24px;
            box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.03);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .premium-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 40px -4px rgba(15, 23, 42, 0.08);
            border-color: rgba(203, 213, 225, 1);
        }
    </style>
    
</head>
<body class="antialiased text-slate-900 selection:bg-primary-100 selection:text-primary-900">
    <%- include('../partials/sidebar') %>

    <main class="lg:ml-64 min-h-screen transition-all duration-300 rtl:ml-0 rtl:lg:mr-64 relative overflow-hidden">
        <!-- Subtle background elements -->
        <div class="absolute inset-0 pointer-events-none overflow-hidden z-0">
            <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>
            <div class="absolute top-40 -left-40 w-96 h-96 bg-indigo-100 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>
        </div>

        <div class="relative z-10">
            <!-- Mobile Header -->
            <header class="lg:hidden sticky top-0 z-40 bg-white/80 backdrop-blur-xl border-b border-slate-100 px-5 py-4 flex items-center justify-between shadow-sm">
                <img src="/images/logo.jpeg" alt="Logo" class="h-8 w-auto rounded-lg object-contain">
                <div class="flex items-center gap-3">
                    <button onclick="toggleLang()" class="w-9 h-9 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 hover:bg-slate-200 transition-colors">
                        <i class="fa-solid fa-earth-asia"></i>
                    </button>
                    <% if(typeof is_guest !=='undefined' && is_guest) { %>
                        <button onclick="window.location.href='/auth/login'" class="text-xs font-bold text-white bg-slate-900 px-4 py-2 rounded-xl shadow-md" data-en="Log In" data-ur="لاگ اِن">Log In</button>
                    <% } else { %>
                        <a href="/auth/logout" class="text-xs font-bold text-slate-600 bg-slate-100 px-4 py-2 rounded-xl hover:bg-slate-200 transition-colors" data-en="Logout" data-ur="لاگ آؤٹ">Logout</a>
                    <% } %>
                </div>
            </header>

            <div class="max-w-6xl mx-auto px-5 lg:px-8 py-10 lg:py-14">
                <!-- Header -->
                <div class="flex items-start justify-between gap-6 mb-10 rtl:flex-row-reverse">
                    <div class="min-w-0">
                        <h1 class="text-3xl lg:text-4xl font-black display-font tracking-tight mb-2">
                            <span data-en="Welcome back," data-ur="خوش آمدید،">Welcome back,</span>
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-slate-900 to-slate-600"><%= typeof user_name !== 'undefined' ? user_name : 'User' %>!</span>
                            <span class="ml-1 inline-block animate-bounce origin-bottom">👋</span>
                        </h1>
                        <p class="text-slate-500 font-medium text-sm lg:text-base rtl:text-right" data-en="Here’s what’s happening with your magic creations today." data-ur="آج آپ کے جادوئی کاموں کی تازہ صورتحال یہ ہے۔">
                            Here’s what’s happening with your prompts today.
                        </p>
                        <div class="mt-4 inline-flex items-center gap-2 rounded-xl bg-white border border-slate-200 px-4 py-2 shadow-sm">
                            <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider" data-en="Current Plan" data-ur="موجودہ پلان">Current Plan</span>
                            <span id="current-plan-pill" class="text-xs font-black text-primary-600"><%= (subscription?.plan || 'free').toUpperCase() %></span>
                            <span id="current-plan-status" class="text-[11px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-md"><%= subscription?.status || 'inactive' %></span>
                        </div>
                    </div>

                    <div class="hidden lg:flex items-center gap-2">
                        <button onclick="toggleLang()" class="text-sm font-bold text-slate-600 bg-white border border-slate-200 px-5 py-2.5 rounded-xl hover:bg-slate-50 hover:border-slate-300 transition-all flex items-center gap-2 shadow-sm focus:ring-2 focus:ring-slate-200 outline-none">
                            <i class="fa-solid fa-earth-asia text-slate-400"></i> <span id="lang-label">EN / اردو</span>
                        </button>
                    </div>
                </div>

                <!-- Stats -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
                    <div class="premium-card p-6 flex flex-col justify-between group">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                                <i class="fa-solid fa-wand-magic-sparkles text-xl"></i>
                            </div>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400" data-en="Magic Generated" data-ur="بنے ہوئے جادو">Prompts Generated</p>
                            <p id="total-creations-value" class="text-3xl font-black text-slate-900 mt-1 ltr-only tracking-tight"><%= stats?.creations ?? 0 %></p>
                            <p class="text-xs text-slate-400 font-medium mt-1" data-en="All-time generated" data-ur="اب تک تخلیق کردہ">All-time generated</p>
                        </div>
                    </div>

                    <div class="premium-card p-6 flex flex-col justify-between group">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300">
                                <i class="fa-solid fa-bolt text-xl"></i>
                            </div>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400" data-en="Today's Usage" data-ur="آج کا استعمال">Today's Usage</p>
                            <p id="today-usage-value" class="text-3xl font-black text-slate-900 mt-1 ltr-only tracking-tight"><%= usage?.usedToday ?? 0 %> <span class="text-slate-300 text-2xl">/</span> <%= usage?.dailyLimit ?? '∞' %></p>
                            <p id="today-usage-subtext" class="text-xs text-slate-400 font-medium mt-1"><%= usage?.isLimited ? `${usage?.remainingToday ?? 0} remaining today` : 'Unlimited on your current plan' %></p>
                        </div>
                    </div>

                    <div class="premium-card p-6 flex flex-col justify-between group">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center group-hover:scale-110 group-hover:bg-amber-500 group-hover:text-white transition-all duration-300">
                                <i class="fa-solid fa-chart-simple text-xl"></i>
                            </div>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400" data-en="Tokens Used" data-ur="استعمال شدہ ٹوکنز">Tokens Used</p>
                            <p id="tokens-used-value" class="text-3xl font-black text-slate-900 mt-1 ltr-only tracking-tight"><%= stats?.tokensUsed ?? 0 %></p>
                            <p class="text-xs text-slate-400 font-medium mt-1" data-en="Chars processed in last 30 days" data-ur="گزشتہ 30 دن میں پروسیس شدہ حروف">Chars processed in last 30 days</p>
                        </div>
                    </div>

                    <div class="premium-card p-6 flex flex-col justify-between group">
                        <div class="flex items-start justify-between gap-4 mb-4">
                            <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center group-hover:scale-110 group-hover:bg-rose-500 group-hover:text-white transition-all duration-300">
                                <i class="fa-solid fa-heart text-xl"></i>
                            </div>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold uppercase tracking-wider text-slate-400" data-en="Favorites" data-ur="پسندیدہ">Favorites</p>
                            <p id="favorites-value" class="text-3xl font-black text-slate-900 mt-1 ltr-only tracking-tight"><%= stats?.favorites ?? 0 %></p>
                            <p class="text-xs text-slate-400 font-medium mt-1" data-en="Saved instructions" data-ur="محفوظ ہدایات">Saved prompts</p>
                        </div>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="premium-card p-6 lg:p-8 mb-10">
                    <div class="mb-6 rtl:text-right">
                        <h2 class="text-lg font-black display-font text-slate-900" data-en="Quick Actions" data-ur="فوری ایکشنز">Quick Actions</h2>
                        <p class="text-sm text-slate-500 font-medium mt-1" data-en="Start creating prompts with one click." data-ur="ایک کلک میں پرامپٹ بنائیں۔">Start creating prompts with one click.</p>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <a href="/user/generate-prompt" class="group flex items-center gap-4 p-5 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                            <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center group-hover:border-blue-200 group-hover:text-blue-600 transition-colors shadow-sm">
                                <i class="fa-solid fa-plus text-lg"></i>
                            </div>
                            <div>
                                <div class="text-sm font-bold text-slate-900 group-hover:text-blue-700 transition-colors" data-en="Generate Magic" data-ur="جادو بنائیں">Generate Magic</div>
                                <div class="text-xs text-slate-500 font-medium mt-0.5" data-en="New prompt in seconds" data-ur="چند سیکنڈ میں">New prompt in seconds</div>
                            </div>
                        </a>
                        <a href="/user/enhance-creation" class="group flex items-center gap-4 p-5 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                            <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center group-hover:border-indigo-200 group-hover:text-indigo-600 transition-colors shadow-sm">
                                <i class="fa-solid fa-wand-magic-sparkles text-lg"></i>
                            </div>
                            <div>
                                <div class="text-sm font-bold text-slate-900 group-hover:text-indigo-700 transition-colors" data-en="Refine Magic" data-ur="جادو سنواریں">Refine Magic</div>
                                <div class="text-xs text-slate-500 font-medium mt-0.5" data-en="Improve existing prompt" data-ur="پہلے سے موجود">Improve existing prompt</div>
                            </div>
                        </a>
                        <a href="/user/templates" class="group flex items-center gap-4 p-5 rounded-2xl bg-slate-50 hover:bg-white border border-transparent hover:border-slate-200 hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
                            <div class="w-12 h-12 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center group-hover:border-emerald-200 group-hover:text-emerald-600 transition-colors shadow-sm">
                                <i class="fa-solid fa-layer-group text-lg"></i>
                            </div>
                            <div>
                                <div class="text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition-colors" data-en="Use Template" data-ur="ٹیمپلیٹ استعمال کریں">Use Template</div>
                                <div class="text-xs text-slate-500 font-medium mt-0.5" data-en="Start from a template" data-ur="ٹیمپلیٹ سے">Start from a template</div>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- Two Columns -->
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-6">
                    <!-- Recent -->
                    <div class="premium-card p-6 lg:p-8 flex flex-col">
                        <div class="flex items-center justify-between gap-4 mb-6 rtl:flex-row-reverse border-b border-slate-100 pb-4">
                            <div>
                                <h3 class="text-lg font-black display-font text-slate-900" data-en="Recent Magic" data-ur="حالیہ جادو">Recent Prompts</h3>
                                <p class="text-sm text-slate-500 font-medium mt-1" data-en="Your latest magic creations" data-ur="آپ کی تازہ جادوئی تخلیقات">Your latest prompt generations</p>
                            </div>
                            <a href="/user/history-page" class="text-xs font-bold text-primary-600 hover:text-primary-700 bg-primary-50 hover:bg-primary-100 px-4 py-2 rounded-lg transition-colors whitespace-nowrap" data-en="View all →" data-ur="سب دیکھیں →">View all &rarr;</a>
                        </div>

                        <% if (recent && recent.length) { %>
                            <div class="space-y-4 flex-1">
                                <% recent.forEach((r) => { %>
                                    <div class="flex items-start gap-4 p-4 rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all group">
                                        <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-500 flex items-center justify-center shrink-0 group-hover:bg-primary-50 group-hover:text-primary-600 transition-colors">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-start justify-between gap-3 rtl:flex-row-reverse mb-1">
                                                <p class="font-bold text-slate-900 text-sm line-clamp-1 group-hover:text-primary-700 transition-colors"><%= (r.original_input || '').slice(0, 60) || '—' %></p>
                                                <span class="text-[10px] font-bold text-slate-400 whitespace-nowrap ltr-only bg-slate-100 px-2 py-0.5 rounded-md"><%= r.created_at ? String(r.created_at).slice(0, 10) : '' %></span>
                                            </div>
                                            <p class="text-xs text-slate-500 font-medium line-clamp-2 leading-relaxed"><%= (r.enhanced_result || '').slice(0, 150) %></p>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="flex-1 flex flex-col items-center justify-center p-10 text-center">
                                <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center text-slate-300 mb-4">
                                    <i class="fa-solid fa-box-open text-2xl"></i>
                                </div>
                                <p class="text-base font-bold text-slate-700" data-en="No magic yet" data-ur="ابھی کوئی جادو نہیں">No prompts yet</p>
                                <p class="text-sm text-slate-500 font-medium mt-2 max-w-xs" data-en="Create your first magic instruction to see it here." data-ur="پہلی ہدایت بنائیں، یہ یہاں نظر آئے گی۔">Create your first prompt to see it here.</p>
                                <a href="/user/generate-prompt" class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-primary-600 hover:text-primary-700 transition-colors">
                                    <span data-en="Start creating" data-ur="بنانا شروع کریں">Start creating</span> <i class="fa-solid fa-arrow-right rtl:rotate-180"></i>
                                </a>
                            </div>
                        <% } %>
                    </div>

                    <!-- Popular Templates -->
                    <div class="premium-card p-6 lg:p-8 flex flex-col">
                        <div class="flex items-center justify-between gap-4 mb-6 rtl:flex-row-reverse border-b border-slate-100 pb-4">
                            <div>
                                <h3 class="text-lg font-black display-font text-slate-900" data-en="Popular Templates" data-ur="مشہور ٹیمپلیٹس">Popular Templates</h3>
                                <p class="text-sm text-slate-500 font-medium mt-1" data-en="Most used by the community" data-ur="کمیونٹی میں زیادہ استعمال">Most used by the community</p>
                            </div>
                            <a href="/user/templates" class="text-xs font-bold text-slate-500 hover:text-slate-900 bg-slate-50 hover:bg-slate-100 px-4 py-2 rounded-lg transition-colors whitespace-nowrap" data-en="Browse all →" data-ur="سب دیکھیں →">Browse all &rarr;</a>
                        </div>

                        <div class="space-y-4 flex-1">
                            <a href="/user/templates" class="block p-4 rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all group">
                                <div class="flex items-center gap-4 rtl:flex-row-reverse">
                                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                        <i class="fa-solid fa-code"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-slate-900 text-sm group-hover:text-emerald-700 transition-colors" data-en="Debug & Refactor Code" data-ur="فنکشن ڈیبگ اور ریفیکٹر">Debug & Refactor Code</p>
                                        <p class="text-xs text-slate-500 font-medium mt-1" data-en="Perfect for cleaning up messy code files." data-ur="بے ترتیبی کوڈ صاف کرنے کے لیے۔">Perfect for cleaning up messy code files.</p>
                                    </div>
                                    <i class="fa-solid fa-chevron-right text-slate-300 rtl:rotate-180 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
                            <a href="/user/templates" class="block p-4 rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all group">
                                <div class="flex items-center gap-4 rtl:flex-row-reverse">
                                    <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                        <i class="fa-solid fa-bullhorn"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-slate-900 text-sm group-hover:text-blue-700 transition-colors" data-en="Social Media Campaign" data-ur="سوشل میڈیا مہم">Social Media Campaign</p>
                                        <p class="text-xs text-slate-500 font-medium mt-1" data-en="Create a complete 30-day content plan." data-ur="مکمل کنٹینٹ پلان بنائیں۔">Create a complete 30-day content plan.</p>
                                    </div>
                                    <i class="fa-solid fa-chevron-right text-slate-300 rtl:rotate-180 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
                            <a href="/user/templates" class="block p-4 rounded-2xl hover:bg-slate-50 border border-transparent hover:border-slate-100 transition-all group">
                                <div class="flex items-center gap-4 rtl:flex-row-reverse">
                                    <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
                                        <i class="fa-solid fa-pen-nib"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="font-bold text-slate-900 text-sm group-hover:text-amber-700 transition-colors" data-en="SEO Blog Article" data-ur="بلاگ تعارف لکھیں">SEO Blog Article</p>
                                        <p class="text-xs text-slate-500 font-medium mt-1" data-en="Write engaging, optimized articles." data-ur="پہلی لائن سے ہی قاری کو پکڑیں۔">Write engaging, optimized articles.</p>
                                    </div>
                                    <i class="fa-solid fa-chevron-right text-slate-300 rtl:rotate-180 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-1"></i>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <%- include('../partials/bottom_nav') %>

    <script>
        function formatCompactNumber(value) {
            const num = Number(value || 0);
            return num >= 1000 ? `${(num / 1000).toFixed(1)}k` : String(num);
        }

        async function hydrateDashboard() {
            try {
                const response = await fetch('/user/dashboard-data');
                if (!response.ok) return;
                const contentType = response.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) return;
                const data = await response.json();

                document.getElementById('total-creations-value').textContent = String(data?.stats?.creations || 0);
                document.getElementById('favorites-value').textContent = String(data?.stats?.favorites || 0);
                document.getElementById('tokens-used-value').textContent = formatCompactNumber(data?.stats?.tokensUsed || 0);

                const isLimited = Boolean(data?.usage?.isLimited);
                const usedToday = Number(data?.usage?.usedToday || 0);
                const planCode = String(data?.subscription?.plan || '').toLowerCase();
                const fallbackLimit = planCode === 'guest' ? 10 : 40;
                const dailyLimit = isLimited ? Number(data?.usage?.dailyLimit || fallbackLimit) : '∞';
                
                // Keep the slash styling for usage
                document.getElementById('today-usage-value').innerHTML = `${usedToday} <span class="text-slate-300 text-2xl font-normal mx-0.5">/</span> ${dailyLimit}`;
                
                document.getElementById('today-usage-subtext').textContent = isLimited
                    ? `${Math.max(0, Number(data?.usage?.remainingToday || 0))} remaining today`
                    : 'Unlimited on your current plan';

                document.getElementById('current-plan-pill').textContent = String(data?.subscription?.plan || 'free').toUpperCase();
                document.getElementById('current-plan-status').textContent = String(data?.subscription?.status || 'inactive');
            } catch (_) {}
        }

        function toggleLang() {
            const currentLang = localStorage.getItem('preferred_lang') === 'en' ? 'ur' : 'en';
            localStorage.setItem('preferred_lang', currentLang);
            if (typeof globalApplyLang === 'function') globalApplyLang();
        }

        document.addEventListener('DOMContentLoaded', hydrateDashboard);
    </script>
</body>
</html>
