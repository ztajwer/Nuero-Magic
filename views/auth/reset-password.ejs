<!DOCTYPE html>
<html lang="en" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set New Password | NeuroMagic</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/jameel-noori@1.1.2/jameel-noori.min.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>tailwind.config={theme:{extend:{fontFamily:{sans:['Inter','sans-serif'],display:['Outfit','sans-serif'],urdu:['Jameel Noori Nastaleeq','sans-serif']}}}}</script>
    <style>
        body { background-color: #fcfcfd; font-family: 'Inter', sans-serif; transition: all 0.3s ease; }
        .display-font { font-family: 'Outfit', sans-serif; }
        .hero-gradient { background: radial-gradient(circle at 50% -20%, rgba(59, 130, 246, 0.08) 0%, rgba(252, 252, 253, 1) 70%); }
        [dir="rtl"] { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; }
        [dir="rtl"] .display-font { font-family: 'Jameel Noori Nastaleeq', sans-serif !important; }
    </style>
</head>
<body class="antialiased text-slate-900 min-h-screen flex flex-col justify-center items-center px-6 hero-gradient">

    <div class="fixed top-6 right-6 z-50">
        <button onclick="toggleLang()" class="text-xs font-bold text-slate-500 bg-white border border-slate-100 px-4 py-2 rounded-xl hover:bg-slate-50 transition-all flex items-center gap-2 shadow-sm">
            <i class="fa-solid fa-earth-asia"></i> <span id="lang-label">EN / اردو</span>
        </button>
    </div>

    <div class="mb-10 text-center">
        <div class="flex items-center gap-3 justify-center mb-12">
            <img src="/images/logo.jpeg" alt="Logo" class="h-16 w-auto object-contain rounded-xl">
        </div>
        <h1 class="text-4xl font-extrabold display-font tracking-tight mb-2" data-en="Set new password" data-ur="نیا پاس ورڈ سیٹ کریں">Set new password</h1>
        <p class="text-slate-500 font-medium" data-en="Enter your new password below." data-ur="نیچے اپنا نیا پاس ورڈ درج کریں۔">Enter your new password below.</p>
    </div>

    <div class="w-full max-w-md bg-white border border-slate-100 rounded-[40px] p-10 shadow-2xl shadow-blue-500/5">

        <% if (typeof error !== 'undefined' && error) { %>
        <div class="bg-red-50 border border-red-200 rounded-2xl p-4 mb-6">
            <p class="text-red-600 text-sm font-semibold flex items-center gap-2"><i class="fa-solid fa-circle-exclamation text-xs"></i> <%= error %></p>
        </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
        <div class="bg-emerald-50 border border-emerald-200 rounded-2xl p-4 mb-6">
            <p class="text-emerald-600 text-sm font-semibold flex items-center gap-2"><i class="fa-solid fa-check-circle text-xs"></i> <%= success %></p>
        </div>
        <% } %>

        <% if (!(typeof error !== 'undefined' && error) && !(typeof success !== 'undefined' && success) && typeof user !== 'undefined' && user) { %>
        <form method="POST" class="space-y-6">
            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-widest pl-1" data-en="New Password" data-ur="نیا پاس ورڈ">New Password</label>
                <div class="relative">
                    <input type="password" id="reset-password" name="password" required placeholder="••••••••" class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-medium focus:outline-none focus:border-blue-500 transition-all placeholder:text-slate-300 pr-12">
                    <button type="button" onclick="togglePassword('reset-password')" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none">
                        <i class="fa-solid fa-eye" id="reset-password-icon"></i>
                    </button>
                </div>
            </div>

            <div class="flex flex-col gap-1">
                <label class="text-xs font-bold text-slate-400 uppercase tracking-widest pl-1" data-en="Confirm Password" data-ur="پاس ورڈ کی تصدیق کریں">Confirm Password</label>
                <div class="relative">
                    <input type="password" id="reset-confirm" name="confirm" required placeholder="••••••••" class="w-full bg-slate-50 border border-slate-100 rounded-2xl px-6 py-4 font-medium focus:outline-none focus:border-blue-500 transition-all placeholder:text-slate-300 pr-12">
                    <button type="button" onclick="togglePassword('reset-confirm')" class="absolute right-4 top-1/2 transform -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none">
                        <i class="fa-solid fa-eye" id="reset-confirm-icon"></i>
                    </button>
                </div>
            </div>

            <button type="submit" name="reset" class="w-full py-5 bg-slate-900 text-white rounded-2xl font-bold shadow-xl shadow-slate-900/10 hover:bg-black transition-all active:scale-95 text-lg" data-en="Reset Password" data-ur="پاس ورڈ تبدیل کریں">
                Reset Password
            </button>
        </form>
        <% } %>

        <div class="mt-8 pt-8 border-t border-slate-50 text-center">
            <a href="/auth/login" class="text-blue-600 font-bold hover:underline" data-en="Back to Login" data-ur="لاگ ان پر واپس جائیں">Back to Login</a>
        </div>

    </div>

    <script>
        function toggleLang() {
            const currentLang = localStorage.getItem('preferred_lang') === 'en' ? 'ur' : 'en';
            localStorage.setItem('preferred_lang', currentLang);
            applyLang();
        }

        function togglePassword(inputId) {
            const passwordInput = document.getElementById(inputId);
            const passwordIcon = document.getElementById(inputId + '-icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                passwordIcon.classList.remove('fa-eye');
                passwordIcon.classList.add('fa-eye-slash');
            } else {
                passwordInput.type = 'password';
                passwordIcon.classList.remove('fa-eye-slash');
                passwordIcon.classList.add('fa-eye');
            }
        }

        function applyLang() {
            const lang = localStorage.getItem('preferred_lang') || 'en';
            const ur = lang === 'ur';
            const root = document.getElementById('html-root');
            root.setAttribute('dir', ur ? 'rtl' : 'ltr');
            
            // Font Size
            document.body.style.fontSize = ur ? '1.1rem' : '';

            // Logo Swap
            const logo = document.querySelector('img[alt="Logo"]');
            if (logo) logo.src = ur ? '/images/logourdu.jpeg' : '/images/logo.jpeg';

            document.querySelectorAll('[data-en]').forEach(el => {
                const text = ur ? el.getAttribute('data-ur') : el.getAttribute('data-en');
                if (text) {
                    const icon = el.querySelector('i');
                    if (icon) {
                        const temp = icon.outerHTML;
                        el.innerHTML = temp + ' ' + text;
                    } else {
                        el.innerText = text;
                    }
                }
            });
            document.querySelectorAll('[data-placeholder-en]').forEach(el => {
                el.placeholder = ur ? el.getAttribute('data-placeholder-ur') : el.getAttribute('data-placeholder-en');
            });
        }
        window.onload = applyLang;
    </script>
</body>
</html>